{
  "name": "@chame/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Charme Total para Windows",
  "author": "Charme Total",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "test": "node --test policy.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.charmetotal.desktop",
    "productName": "Charme Total",
    "copyright": "Copyright ? 2026 Charme Total",
    "asar": true,
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "preload.cjs",
      "connection.html",
      "connection.js",
      "connection.css",
      "brand.png",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "CharmeTotal"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Charme Total",
      "runAfterFinish": false,
      "artifactName": "Charme-Total-Setup-${version}-${arch}.${ext}"
    }
  }
}
