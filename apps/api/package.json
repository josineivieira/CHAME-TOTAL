{
    "name": "@chame/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "generate": "prisma generate",
        "migrate": "prisma migrate deploy",
        "migrate:dev": "prisma migrate dev",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "start": "node dist/src/main.js",
        "test": "tsx --test test/unit/*.test.ts",
        "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
        "admin:create": "tsx scripts/create-admin.ts",
        "test:e2e": "tsx --test --test-concurrency=1 test/e2e/*.test.ts",
        "db:verify": "tsx scripts/verify-database.ts"
    },
    "dependencies": {
        "@chame/shared": "0.1.0",
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/swagger": "12.0.2",
        "@prisma/adapter-pg": "6.19.3",
        "@prisma/client": "6.19.3",
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.2.3",
        "exceljs": "4.4.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "luxon": "^3.7.2",
        "nodemailer": "10.1.1",
        "otpauth": "^9.4.1",
        "pdfkit": "^0.17.2",
        "pg": "^8.16.3",
        "pino": "^10.1.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.5",
        "@types/luxon": "^3.7.1",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.4",
        "@types/pdfkit": "^0.17.3",
        "@types/pg": "^8.15.6",
        "@types/supertest": "^6.0.3",
        "prisma": "6.19.3",
        "supertest": "^7.1.4",
        "tsx": "^4.20.6"
    }
}
